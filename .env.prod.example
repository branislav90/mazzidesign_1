# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_PASSWORD=Woodwork!Prod2026

# --- API secrets ------------------------------------------------------------
# 32+ random chars. Generate e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
REVALIDATE_SECRET=change-me-revalidate-secret

# Seeded workshop admin login (used to sign in at /admin).
ADMIN_EMAIL=admin@woodwork.local
ADMIN_PASSWORD=Admin!Prod2026

# --- Public addresses (how the BROWSER reaches each service) ----------------
# Local demo: keep localhost. Public VM: use http://YOUR_HOST_OR_IP:PORT.
# These must match what the customer's browser uses (CORS + API calls depend on it).
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5080
